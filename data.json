  "first_aid": [
    {
      "id": "cpr",
      "titleBn": "সিপিআর (CPR)",
      "titleEn": "Cardiopulmonary Resuscitation",
      "category": "Emergency",
      "steps": [
        "রোগীকে শক্ত ও সমতল স্থানে শোয়ান।",
        "বুকের মাঝখানে দুই হাত রেখে পরপর ৩০ বার জোরে চাপ দিন।",
        "মুখে মুখ রেখে ২ বার শ্বাস দিন এবং দ্রুত হাসপাতালে নেওয়ার ব্যবস্থা করুন।"
      ]
    },
    {
      "id": "choking",
      "titleBn": "গলায় কিছু আটকানো (Choking)",
      "titleEn": "Choking Emergency",
      "category": "Emergency",
      "steps": [
        "আক্রান্ত ব্যক্তিকে সামনে ঝুঁকিয়ে পিঠে ৫ বার থাপ্পড় দিন।",
        "কাজ না হলে পেটে পেছন থেকে জড়িয়ে ধরে ওপরের দিকে চাপ দিন (Heimlich Maneuver)।"
      ]
    },
    {
      "id": "bleeding",
      "titleBn": "প্রবল রক্তপাত (Severe Bleeding)",
      "titleEn": "Severe Bleeding Control",
      "category": "Trauma",
      "steps": [
        "ক্ষতস্থানে পরিষ্কার কাপড় বা গজ দিয়ে শক্ত করে চেপে ধরুন।",
        "সম্ভব হলে রক্তপাতের স্থানটি হৃদপিণ্ডের স্তরের ওপরে তুলে রাখুন।",
        "কাপড় ভিজে গেলে তা না তুলে ওপরে আরও একটি পরিষ্কার কাপড় দিয়ে চাপ দিয়ে ধরে রাখুন।"
      ]
    },
    {
      "id": "burns",
      "titleBn": " আগুনে পোড়া (Burns)",
      "titleEn": "Burn First Aid",
      "category": "Injury",
      "steps": [
        "পোড়া স্থানে অন্তত ১০-১৫ মিনিট নরমাল ঠান্ডা পানি ঢালুন (বরফ ব্যবহার করবেন না)।",
        "কোনো মলম, ঘি বা টুথপেস্ট লাগাবেন না।",
        "ক্ষতস্থান পরিষ্কার সুতির শুকনো কাপড় দিয়ে হালকাভাবে ঢেকে দ্রুত ডাক্তারের কাছে যান।"
      ]
    },
    {
      "id": "snake_bite",
      "titleBn": "সাপের কামড় (Snake Bite)",
      "titleEn": "Snake Bite First Aid",
      "category": "Poisoning",
      "steps": [
        "রোগীকে শান্ত রাখুন এবং আক্রান্ত অঙ্গটি শক্ত না করে একদম স্থির রাখুন।",
        "কামড়ের জায়গায় ব্লেড দিয়ে চেরা বা মুখ দিয়ে বিষ চোষার চেষ্টা করবেন না।",
        "কোনো বাঁধন অতিরিক্ত শক্ত করে দেবেন না; যত দ্রুত সম্ভব অ্যান্টি-ভেনম (AVS) যুক্ত হাসপাতালে নিয়ে যান।"
      ]
    },
    {
      "id": "fracture",
      "titleBn": "হাড় ভাঙা বা মচকানো (Fracture/Sprain)",
      "titleEn": "Bone Fracture or Sprain",
      "category": "Injury",
      "steps": [
        "আক্রান্ত অঙ্গটি নাড়াচাড়া করা বন্ধ রাখুন।",
        "স্কেলিং বা শক্ত কোনো কাঠের টুকরো ও কাপড়ের সাহায্যে ভাঙা স্থানটি সোজা করে সাপোর্ট দিয়ে রাখুন।",
        "ফোলা কমাতে তোয়ালেতে বরফ পেঁচিয়ে হালকা শেক দিন।"
      ]
    },
    {
      "id": "heat_stroke",
      "titleBn": "হিটস্ট্রোক (Heat Stroke)",
      "titleEn": "Heat Stroke Management",
      "category": "Environmental",
      "steps": [
        "রোগীকে দ্রুত ঠান্ডা বা ছায়াযুক্ত স্থানে নিয়ে যান।",
        "শরীরের অতিরিক্ত পোশাক খুলে দিন এবং ঠান্ডা পানি দিয়ে শরীর মুছে দিন বা বাতাস করুন।",
        "জ্ঞান থাকলে স্যালাইন বা পানি পান করান।"
      ]
    },
    {
      "id": "electric_shock",
      "titleBn": "বিদ্যুৎস্পৃষ্ট (Electric Shock)",
      "titleEn": "Electric Shock Response",
      "category": "Emergency",
      "steps": [
        "আগে মূল পাওয়ার সোর্স বা মেইন সুইচ বন্ধ করুন।",
        "পাওয়ার বন্ধ না করতে পারলে শুকনো কাঠ বা প্লাস্টিক দিয়ে ভুক্তভোগীকে বিদ্যুতের উৎস থেকে আলাদা করুন।",
        "রোগীর শ্বাস-প্রশ্বাস পরীক্ষা করুন এবং প্রয়োজনে CPR শুরু করুন।"
      ]
    }
  ]
}
